# --- LLM ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Use either the ID or the full URL of your existing Google Sheet.
GOOGLE_SPREADSHEET_ID=your_existing_sheet_id
# GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your_existing_sheet_id/edit

# --- Behavior ---
MAX_TOOL_RETRIES=2
DEFAULT_ROW_COUNT=25
LOG_LEVEL=INFO
